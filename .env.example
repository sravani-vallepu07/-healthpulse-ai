# Database Configuration (PostgreSQL for Docker/Production, SQLite for zero-config local tests)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=sqlite:///./healthcare_platform.db
# For PostgreSQL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Security & Authentication
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
LLM_PROVIDER=structured_agent # structured_agent, openai, anthropic, gemini
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini # or claude-3-5-sonnet-20241022, gemini-1.5-pro

# Voice & Browser Configuration
VOICE_PROVIDER=browser # browser, mock, external
VOICE_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# Telephony Configuration (PRD §11)
TELEPHONY_PROVIDER=mock # mock, twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

