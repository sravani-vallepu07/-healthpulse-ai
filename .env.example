# Database Configuration (PostgreSQL for Docker/Production, SQLite for zero-config local tests)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=sqlite:///./healthcare_platform.db
# For PostgreSQL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Security & Authentication
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
LLM_PROVIDER=structured_agent # structured_agent, openai, gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Voice Configuration
VOICE_PROVIDER=browser # browser, mock, external
VOICE_API_KEY=
STT_API_KEY=
TTS_API_KEY=

